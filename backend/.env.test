# Test environment. Loaded by tests/setup/env.js; values already present in the
# shell win, so CI can point at its own MySQL. Start a local test DB with:
#   docker run -d --name matcha-test-db -e MYSQL_ROOT_PASSWORD=root -e MYSQL_DATABASE=matcha_test -p 3307:3306 mysql:8
NODE_ENV=test
DB_HOST=127.0.0.1
DB_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=root
DB_NAME=matcha_test
JWT_SECRET=test-jwt-secret
FRONTEND_PUBLIC_URL=http://localhost:3000
FACEBOOK_CLIENT_ID=test
FACEBOOK_CLIENT_SECRET=test
GOOGLE_CLIENT_ID=test
GOOGLE_CLIENT_SECRET=test
FORTY_TWO_CLIENT_ID=test
FORTY_TWO_CLIENT_SECRET=test
GOOGLE_GEOCODE_API_KEY=test
CLOUDINARY_CLOUD_NAME=test
CLOUDINARY_CLOUD_KEY=test
CLOUDINARY_CLOUD_SECRET=test
